NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Neon: copy the connection string from the Neon dashboard (it ends in ?sslmode=require).
# Local Docker: postgres://postgres:postgres@localhost:5432/ha_clothing
DATABASE_URL=postgres://user:password@host/ha_clothing?sslmode=require
# Optional. Defaults to true when DATABASE_URL contains sslmode=require.
DATABASE_SSL=

JWT_SECRET=replace-me

# Payments (real keys are shared privately, never committed)
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
PAYHERE_MERCHANT_ID=replace-me
PAYHERE_MERCHANT_SECRET=replace-me
